# Copy to .env and replace each secret with a different random value of at least 32 characters.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PORT=5005
MONGO_URI=mongodb://127.0.0.1:27017/italy
JWT_ACCESS_SECRET=replace-with-a-unique-random-value-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-value-at-least-32-characters
TOKEN_ENC_KEY=replace-with-another-unique-random-value-at-least-32-characters
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
